class AssetsDao extends DatabaseAccessor<TradingDatabase> with _$AssetDaoMixin {
  AssetsDao(TradingDatabase db) : super(db);

  // 插入新账户
  Future<int> insertAssets(AssetsCompanion assets) {
    return into(db.assets).insert(assets);
  }

  // 根据ID获取账户
  Future<Asset> getAssetsById(int id) {
    return (select(db.assets)..where((a) => a.id.equals(id))).getSingle();
  }

  // 获取所有账户
  Future<List<Asset>> getAllAssets() {
    return select(db.assets).get();
  }

  // 删除账户
  Future<int> deleteAssets(int id) {
    return (delete(db.assets)..where((a) => a.id.equals(id))).go();
  }

  // 更新账户信息
  Future<bool> updateAccount(AssetsCompanion assets) {
    return update(db.assets).replace(assets);
  }
  // 根据symbol_ID获取账户
  Future<Asset> getAssetsBySymbol(String symbol) {
    return (select(db.assets)..where((a) => a.symbol.equals(symbol))).getSingle();
  }

}
